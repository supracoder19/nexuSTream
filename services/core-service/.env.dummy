# Server Config
SERVER_PORT=10000
SPRING_DEVTOOLS_LIVERELOAD_ENABLED=true
SPRING_DEVTOOLS_RESTART_ENABLED=true

# Database Configuration (Assuming a 'mysql' container service)
DB_HOST=db-service
DB_PORT=3306
DB_NAME=supradb
DB_USERNAME=root
DB_PASSWORD=root
DB_TYPE=mariadb

# Security Secrets
JWT_KEY=Y29tZS10by1teS1hcHAtYmFja2VuZC1zZWN1cml0eS1zdHJpbmctZXhhbXBsZS0zMmJ5dGVz

# JPA Configuration
JPA_DDL_AUTO=update
JPA_SHOW_SQL=true
JPA_FORMAT_SQL=true

# Redis Configuration (Assuming a 'redis-cache' container service)
REDIS_HOST=redis-cache
REDIS_PORT=6379
REDIS_PASSWORD=1234
REDIS_LOG_LEVEL=DEBUG

# Object Storage (Assuming a 'minio' container service)
S3_ENDPOINT=http://10.154.162.64:8081
S3_ADMIN_ENDPOINT=http://minio:9000
AWS_REGION=us-east-1
AWS_ACCESS_KEY=admin
AWS_SECRET_KEY=password123
AWS_S3_BUCKET=nexustream
AWS_S3_PATH_STYLE=true
S3_BASE_URL=/minio/nexustream/

# Message Broker (Assuming a 'kafka' container service on port 9094)
KAFKA_SERVERS=kafka:9094
KAFKA_CONSUMER_GROUP=kafka-tutorial-group
KAFKA_DEFAULT_TYPE=com.nexuSTream.core_service.DTO.Event
KAFKA_TRUSTED_PACKAGES=com.nexuSTream.core_service.DTO